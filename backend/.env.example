# ===============================================
# Configuração do Sistema de Ponto SME - Backend
# ===============================================

# Porta do Servidor
PORT=3000
NODE_ENV=development

# Conexão com Supabase PostgreSQL
# Substitua com a URL de conexão direta do seu projeto no Supabase:
# Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Chave Secreta JWT para Autenticação
JWT_SECRET=sme_ponto_semente_secreta_jwt_2025_homologacao
JWT_EXPIRES_IN=7d

# Diretório de Upload de Atestados e Justificativas
UPLOAD_DIR=uploads
